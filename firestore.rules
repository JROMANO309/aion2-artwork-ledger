rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only someone who knows the party key (from the shared link) can find the party's data.
    // Listing all parties is not allowed, so the key works like a password.
    match /parties/{partyKey}/members/{member} {
      allow get, list: if partyKey.size() >= 16;
      allow write: if partyKey.size() >= 16
        && member in ['Powerful', 'Lovecd', 'nottom', 'mika', 'Sticky']
        && request.resource.data.keys().hasOnly(['owned'])
        && request.resource.data.owned is map
        && request.resource.data.owned.size() <= 100;
    }
    // Battle roster (Aura Legion): anyone with the roster link (#roster=...) can sign up, edit and remove entries.
    match /rosters/{rosterKey}/signups/{signupId} {
      allow get, list, delete: if rosterKey.size() >= 16;
      allow create, update: if rosterKey.size() >= 16
        && signupId.size() <= 40
        && request.resource.data.keys().hasOnly(['name', 'cls', 'cp', 'pin', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.cls is string && request.resource.data.cls.size() <= 30
        && request.resource.data.cp is int
        && request.resource.data.cp >= 0 && request.resource.data.cp <= 999999999
        && (!('pin' in request.resource.data) || request.resource.data.pin == null
            || request.resource.data.pin in ['beso', 'powerful', 'pope'])
        && request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 40;
    }
    // Battle roster settings: party size and how many parties Powerful's Force holds.
    match /rosters/{rosterKey}/settings/{settingId} {
      allow get, list: if rosterKey.size() >= 16;
      allow write: if rosterKey.size() >= 16
        && settingId == 'config'
        && request.resource.data.keys().hasOnly(['partySize', 'powerfulParties'])
        && request.resource.data.partySize is int
        && request.resource.data.partySize >= 2 && request.resource.data.partySize <= 12
        && request.resource.data.powerfulParties is int
        && request.resource.data.powerfulParties >= 0 && request.resource.data.powerfulParties <= 50;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
